# PayPal sandbox credentials (optional — the app runs fully in mock mode without them)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox (default) or live
PAYPAL_MODE=sandbox

# Anthropic Claude API key (optional — without it, the deterministic
# rule-based intent parser is the agent; set it to enable Claude tool-calling)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
